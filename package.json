{
  "name": "herdr-automations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/main.ts",
  "scripts": {
    "start": "bun run src/main.ts",
    "worker": "bun run src/main.ts worker",
    "ui": "bun run src/main.ts ui",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check .",
    "validate:manifest": "bun run scripts/validate-manifest.ts"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
